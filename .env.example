# Knead — environment variables
#
# Copy to .env.local and fill in. Nothing here is required to boot the dev
# server, but each subsystem stays inert until its own block is populated.
# Never commit .env.local.

# ─── LLM providers ────────────────────────────────────────────────────────────
# At least one is needed for the AI surfaces. The router falls back to whichever
# provider isn't primary for a given surface, so setting both is recommended.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Web search tool used by Demeter and the build assistant.
TAVILY_API_KEY=

# ─── Sanity (CMS) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, only needed by write scripts (scripts/backfill-excerpts.ts).
# Not used by the app at runtime. Sanity project → API → Tokens.
SANITY_API_WRITE_TOKEN=
# Viewer token. Without it the draft checker can only read PUBLISHED posts —
# checking a story before it publishes is the whole point, so set this.
SANITY_API_READ_TOKEN=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (membership) ──────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ─── Thirdweb / Base L2 ───────────────────────────────────────────────────────
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=
THIRDWEB_IN_APP_ACCOUNTS_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Contracts
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRIBUTOR_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_REWARDS_CONTRACT_ADDRESS=
NEXT_PUBLIC_EVENT_PASS_CONTRACT=

# Server wallet (mints, payouts). Keep dust-level funds only.
SERVER_WALLET_ADDRESS=
SERVER_WALLET_MIN_GAS_ETH=
ENGINE_SERVER_WALLET_ADDRESS=
ENGINE_VAULT_ACCESS_TOKEN=

# ─── Towns Protocol (encrypted chat) ──────────────────────────────────────────
NEXT_PUBLIC_TOWNS_SPACE_ID=
NEXT_PUBLIC_TOWNS_CONTRACT_ADDRESS=
NEXT_PUBLIC_KNEAD_SPACE_CONTRACT_ADDRESS=
NEXT_PUBLIC_KNEAD_CHAT_SPACE_ID=
NEXT_PUBLIC_KNEAD_CHAT_DEFAULT_CHANNEL_ID=
# TOWNS_AGENT_CHANNEL_ID removed — nothing read it. The agent runner
# (server/agent-runner.ts) uses NEXT_PUBLIC_KNEAD_CHAT_DEFAULT_CHANNEL_ID,
# the same variable as the web app. Setting the old name looked like
# repointing the agent at a new channel and silently did nothing.
TOWNS_CONTRIBUTOR_ROLE_ID=
TOWNS_PARTICIPANT_ROLE_ID=
# Dedicated bot wallets — never a personal wallet.
SPACE_OWNER_PRIVATE_KEY=
KEY_SHARER_PRIVATE_KEY=
AGENT_RUNNER_PRIVATE_KEY=

# ─── Payments agent ───────────────────────────────────────────────────────────
AGENTCARD_CLI_PATH=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─── Social 54 (/social54 monitoring console) ─────────────────────────────────
# Every platform degrades independently: an unconfigured one shows as "not
# configured" in the console with the variables it needs, and never as zero
# activity. Farcaster and Zora work with no credentials at all; the other three
# have no public read path and stay dark until their block is filled in.
#
# Instagram — Graph API. Our own account reads /{ig-user-id}/media, which is the
# only path that returns saves and reach; competitors read through
# business_discovery, which returns neither. Needs a Business/Creator account
# linked to a Facebook Page, and a long-lived token with
# instagram_basic + instagram_manage_insights + pages_read_engagement.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# X — API v2 app-only bearer. public_metrics come back on any tier that can read
# timelines; reply text needs a tier allowing /2/tweets/search/recent, and the
# console says so when it doesn't have one. Standard access reaches back 7 days.
X_BEARER_TOKEN=

# Farcaster — optional. Without it the connector reads the public Warpcast API,
# which works but is unsupported and rate limited. With it, the supported Neynar
# path plus deeper reply threads.
NEYNAR_API_KEY=

# Zora — optional, raises rate limits. ZORA_API_BASE only needs setting if Zora
# moves its endpoints again; the connector reports a shape mismatch by name
# rather than silently returning no collects.
ZORA_API_KEY=
ZORA_API_BASE=

# LinkedIn — Community Management API. Reads OUR page only: LinkedIn scopes post
# reads to organizations the token administers, so competitor data on this
# platform has to come from a pasted comparison. The URN form is
# urn:li:organization:NNNN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
# Defaults to a recent version month; set it if LinkedIn deprecates that one.
LINKEDIN_API_VERSION=

# Knead's own handles. Instagram, X and Farcaster are derived from
# SITE_SOCIAL_PROFILES in lib/constants.ts — these override that when a handle
# changes, so the console never quietly monitors the wrong account.
KNEAD_INSTAGRAM_HANDLE=
KNEAD_X_HANDLE=
KNEAD_FARCASTER_HANDLE=
KNEAD_ZORA_HANDLE=
KNEAD_LINKEDIN_SLUG=

# ─── Media ────────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
DAILY_API_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=

# ─── Auth & sessions ──────────────────────────────────────────────────────────
AUTH_SECRET=
MEMBER_SESSION_SECRET=
ADMIN_SECRET_KEY=
NEXT_PUBLIC_MASTER_ADMIN_WALLET=
OPEN_SOURCE_PASSWORD=

# ─── Build assistant retrieval ────────────────────────────────────────────────
# Read-only token; used to fetch source files at query time.
GITHUB_TOKEN=
KNEAD_GITHUB_REPO=genestjc/knead-v5fr
KNEAD_GITHUB_BRANCH=main

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Optional. Without these, limits fall back to per-instance in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ONBOARD_RATE_LIMIT_PER_HOUR=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Bearer secret for the scheduled routes in vercel.json.
CRON_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
